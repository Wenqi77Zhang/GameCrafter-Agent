FROM python:3.12-slim@sha256:7a8b475003c4fe15a2cd4e55e5cfc2f3560bdc9333d624f24cdd6d4340fd7a17

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

WORKDIR /app

COPY pyproject.toml requirements.lock README.md LICENSE alembic.ini ./

RUN python -m pip install --no-cache-dir --require-hashes -r requirements.lock

COPY src ./src
COPY migrations ./migrations
COPY apps/__init__.py ./apps/__init__.py
COPY apps/api ./apps/api
COPY apps/worker ./apps/worker
COPY fixtures ./fixtures

RUN useradd --create-home --uid 10001 gamecrafter \
    && mkdir -p /app/data/objects \
    && chown -R gamecrafter:gamecrafter /app

USER gamecrafter

CMD ["python", "-m", "uvicorn", "gamecrafter.api.app:app", "--host", "0.0.0.0", "--port", "8000"]

