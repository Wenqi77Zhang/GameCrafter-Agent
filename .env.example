GAMECRAFTER_ENV=local
GAMECRAFTER_LOG_LEVEL=INFO
GAMECRAFTER_API_HOST=127.0.0.1
GAMECRAFTER_API_PORT=8000
GAMECRAFTER_WEB_ORIGIN=http://localhost:5173
GAMECRAFTER_DATABASE_URL=postgresql+psycopg://gamecrafter:gamecrafter_local@127.0.0.1:5432/gamecrafter
GAMECRAFTER_DATA_DIR=./data
GAMECRAFTER_WORKER_ID=local-worker
GAMECRAFTER_WORKER_POLL_SECONDS=1.0
GAMECRAFTER_JOB_LEASE_SECONDS=60

# Local Docker Compose database credentials. Change these before any shared deployment.
GAMECRAFTER_POSTGRES_PASSWORD=gamecrafter_local

# Add provider keys only to a local .env file. Never commit real values.
GAMECRAFTER_MODEL_PROVIDER=disabled
GAMECRAFTER_MODEL_API_KEY=
YOUTUBE_API_KEY=
