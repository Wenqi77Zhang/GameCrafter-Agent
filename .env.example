GAMECRAFTER_ENVIRONMENT=local
GAMECRAFTER_LOG_LEVEL=INFO
GAMECRAFTER_API_HOST=127.0.0.1
GAMECRAFTER_API_PORT=8000
GAMECRAFTER_WEB_ORIGIN=http://localhost:5173
GAMECRAFTER_DATABASE_URL=postgresql+psycopg://gamecrafter:gamecrafter_local@127.0.0.1:5432/gamecrafter
GAMECRAFTER_OBJECT_STORAGE_PATH=./data/objects
GAMECRAFTER_SOURCE_TIMEOUT_SECONDS=20
GAMECRAFTER_SOURCE_HTML_MAX_BYTES=10485760
GAMECRAFTER_SOURCE_IMAGE_MAX_BYTES=5242880
GAMECRAFTER_SOURCE_MAX_IMAGES_PER_PAGE=8
GAMECRAFTER_SOURCE_MAX_REDIRECTS=3
GAMECRAFTER_SOURCE_MIN_INTERVAL_SECONDS=1
GAMECRAFTER_SOURCE_MAX_CONCURRENCY_PER_HOST=1
GAMECRAFTER_SOURCE_GLOBAL_MAX_CONCURRENCY=3
GAMECRAFTER_SOURCE_QUICK_CANDIDATE_LIMIT=30
GAMECRAFTER_SOURCE_TARGETED_CANDIDATE_LIMIT=100
GAMECRAFTER_WORKER_ID=local-worker
GAMECRAFTER_WORKER_POLL_SECONDS=1.0
GAMECRAFTER_JOB_LEASE_SECONDS=60

# Local Docker Compose database credentials. Change these before any shared deployment.
GAMECRAFTER_POSTGRES_PASSWORD=gamecrafter_local

# C2 is strict zero-cost: only disabled or exact offline replay is runnable.
GAMECRAFTER_MODEL_PROVIDER=disabled
GAMECRAFTER_MODEL_REPLAY_FIXTURE_PATH=./fixtures/nte/official-homepage-en-v1.json
GAMECRAFTER_KNOWLEDGE_DOCUMENT_MAX_BYTES=2097152
