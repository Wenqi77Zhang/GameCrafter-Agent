GAMECRAFTER_ENV=local
GAMECRAFTER_LOG_LEVEL=INFO
GAMECRAFTER_API_HOST=127.0.0.1
GAMECRAFTER_API_PORT=8000
GAMECRAFTER_WEB_ORIGIN=http://localhost:5173

# Add provider keys only to a local .env file. Never commit real values.
GAMECRAFTER_MODEL_PROVIDER=disabled
GAMECRAFTER_MODEL_API_KEY=
YOUTUBE_API_KEY=
